    { "name": "脱毛（部位はご相談）", "min": 60, "price": "部位による" }  // 仮（時間）
  ],
  "bufferMin": 20,                     // 仮（片づけ・準備の時間）
  "stepMin": 30,                       // お客さんが選べる開始時間のきざみ
  "patterns": [                        // 仮（営業日の型の初期値。お店の画面で変えられる）
    { "name": "1日", "s": "10:00", "e": "18:00" },
    { "name": "午前", "s": "10:00", "e": "13:00" },
    { "name": "午後", "s": "13:00", "e": "18:00" },
    { "name": "夕方から", "s": "17:00", "e": "21:00" }
  ],
  "bookPatterns": [                    // 予約の型の初期値（お店が手で入れるときの長さ）
