// お店ごとの設定（この1つだけ書きかえる）。// の行は注釈（読むときに外す）。2026/10/20 夜
// colore（コロレ）用。値は 2026/10/21 の打ち合わせでしほさんと決めたもの
{
  "shopName": "よもぎ蒸し/脱毛サロン colore",
  "color": { "main": "#e98ca0", "sub": "#8a6f4e" },   // サイトの --pink と --brown
  "lineUrl": "https://lin.ee/nDeKjiW",
  "tel": "080-7474-4035",
  "menus": [                           // min＝施術の時間（分・お客さんに見せる）。料金は税込。slot＝予約1回の長さ（枠をふさぐ分。書かなければ preMin＋min＋bufferMin）
    { "name": "よもぎ蒸し", "min": 40, "price": "5,500円", "slot": 60 },     // 10/21 決定：予約1回 60分（施術 40分＋前後）
    { "name": "フェイシャル", "min": 30, "price": "5,500円", "slot": 60, "extraMin": 10, "extraNote": "お化粧落とし" },   // 10/21 決定：予約1回 60分（施術 30分・お化粧落としの分を含む）。extraMin＝複数メニューのとき所要に足す 10 分（10/28 決定）
    { "name": "ボディケア 15分", "min": 15, "price": "2,200円" },
    { "name": "ボディケア 30分", "min": 30, "price": "3,300円" },
    { "name": "ボディケア 60分", "min": 60, "price": "6,600円" },
    { "name": "ボディケア 90分", "min": 90, "price": "9,900円" },
    { "name": "ボディケア 120分", "min": 120, "price": "13,200円" },
    { "name": "脱毛", "min": 60, "price": "お問い合わせください" },          // 女性・男性とも1つ。料金は部位で違う
    { "name": "バストアップ", "min": 60, "price": "お問い合わせください" }
  ],
  // ネット予約に出さないメニューの案内（メニューの下に出す。LINE のボタン付き）
  "otherMenusNote": "タクティールケアは、公式LINEでご相談ください。",   // オプションはネットでは選ばせない（来店時にすすめる）
  "preMin": 10,                        // カウンセリングの時間（施術の前。全メニュー共通。10/21 決定）
  "bufferMin": 10,                     // 片づけの時間（施術の後。全メニュー共通。10/21 決定）
  "topNote": "※カウンセリング・お片づけの時間を含めて、少し長めにお時間をいただきます",   // 予約ページの上に出す1行（10/21 決定）
  "maxTotalMin": 180,                  // 複数メニューのとき、施術の合計の上限（分）。越える組み合わせは選べない（10/28 決定）
  "stepMin": 30,                       // お客さんが選べる開始時間のきざみ
  "patterns": [                        // 営業日の型の初期値（お店の画面で変えられる）
    { "name": "1日", "s": "10:00", "e": "18:00" },
    { "name": "午前", "s": "10:00", "e": "13:00" },
    { "name": "午後", "s": "13:00", "e": "18:00" }
  ],
  "bookPatterns": [                    // 予約の型の初期値（お店が手で入れるときの長さ）
    { "name": "よもぎ蒸し", "min": 40 },
    { "name": "ボディケア30", "min": 30 },
    { "name": "ボディケア60", "min": 60 },
    { "name": "ボディケア90", "min": 90 },
    { "name": "フェイシャル", "min": 30 },
    { "name": "脱毛", "min": 60 },
    { "name": "バストアップ", "min": 60 }
  ],
  "cancelPolicy": "前日のキャンセルは料金の50%、当日のキャンセルは料金の100%をいただきます。",
  "notice": "妊娠中の方・持病のある方は、事前にご相談ください。",   // 病気・妊娠は聞かない（決まりごと）
  "askEmail": true,
  // 知らせの送り方（2026/10/21）："gas" ＝ お店の Gmail（Google Apps Script）から、お客さんへ確認メール＋お店へ知らせ。"formspree" ＝ 前の形（画面から Formspree へ）
  "notify": "gas",
  "mail": "coloreyomogi.com@gmail.com",   // お店のメール（10/21 決定。GAS もこのアカウントに入れる）。確認メールの返信先と、お店への知らせの宛先
  "address": "〒747-0011 山口県防府市岸津2丁目3-10 ハイム桜の園203号室",   // 確認メールに書く
  "parking": "駐車場は15番をご利用ください。",                             // 確認メールに書く
  "mapUrl": "https://www.google.com/maps/search/?api=1&query=col%C3%B3re&query_place_id=ChIJfzEnY-6TRDUR4VzRms3tsvo",   // 地図のリンク（完了画面・確認メール）。HP の「道順を見る」と同じ、お店のページで開くリンク。# の付いた住所は使わない（決定事項 08）
  "taxNote": "※料金はすべて税込です",   // メニュー一覧の上の1行（2026/10/25）
  "backUrl": "https://colore-yomogi.com/",   // もどるリンクの行き先（お店のホームページ）
  "backText": "← colore のホームページにもどる",   // もどるリンクの文言
  "formspree": "",                     // notify が formspree のときだけ使う（colore では使わない・作らない。10/21 決定。注釈に引用符は書けない）
  "daysAhead": 0,                      // 何日先まで受けるか。0 ＝ 上限なし（お店の画面で営業日を入れた日はすべて受ける）
  "allowOrigins": ["https://colore-yomogi.com", "https://preview-colore-website.liftoff-358.workers.dev"],   // お店の HP（本番と確認用）から /api/days・/api/book を使える許可。github.io・www は入れない（2026/10/28 本番に出すとき deploy）
  "sameDayCutoffMin": 60               // 当日は1時間前まで
}
