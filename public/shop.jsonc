  "lineUrl": "https://lin.ee/nDeKjiW",
  "tel": "080-7474-4035",
  "menus": [                           // min＝施術の時間（分）
    { "name": "よもぎ蒸し", "min": 40, "price": "5,500円" },
    { "name": "フェイシャル", "min": 60, "price": "5,500円" },           // 仮（時間）
